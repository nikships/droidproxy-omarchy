def log_call(method, params):
    entry = json.dumps({"method": method, "params": params}) + "\n"
    with open(CALL_LOG, "a") as f:
        f.write(entry)


def main():
    args = sys.argv[1:]
    if len(args) >= 2 and args[0] == "ctl" and args[1] == "watch":
        print(json.dumps({"type": "state", "state": STATE}), flush=True)
        while True:
            time.sleep(1)
        return

    if len(args) >= 2 and args[0] == "ctl" and args[1] == "state":
        print(json.dumps(STATE), flush=True)
        return

    if len(args) >= 2 and args[0] == "ctl" and args[1] == "call":
        method = args[2] if len(args) > 2 else ""
        raw = args[3] if len(args) > 3 else "{}"
        try:
            params = json.loads(raw)
        except json.JSONDecodeError:
            params = {}
        log_call(method, params)

        if method == "app.quit":
            print(json.dumps({"ok": True}), flush=True)
            return
        if method == "server.copyUrl":
            print(json.dumps({"ok": True, "message": "Copied"}), flush=True)
            return
        if method == "update.check":
            print(json.dumps({"ok": True}), flush=True)
            return
        if method == "update.install":
            print(json.dumps({"ok": True, "title": "Authentication Result", "message": "✓ Update 1.1.0 installed. Restarting."}), flush=True)
            return
        print(json.dumps({"ok": True, "message": "✓ Mock: " + method}), flush=True)
        return

    print(json.dumps({"ok": False, "error": "mock: unknown command " + " ".join(args)}), flush=True)
    sys.exit(1)


if __name__ == "__main__":
    main()
